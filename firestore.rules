rules_version = '2';

// 日記は本人だけが読み書きできる（.agents/rules/privacy.md）
service cloud.firestore {
  match /databases/{database}/documents {

    // users/{uid} と、その下のすべて（diaries、feedback、forecasts、learnings）
    // rules_version 2 では {document=**} が users/{uid} 自身にも当てはまる
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ここに書いていない場所は、すべて拒否される
  }
}
