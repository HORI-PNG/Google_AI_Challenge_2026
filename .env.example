# このファイルをコピーして .env.local を作り、値を入れてください。
# .env.local は Git に入れません。

# --- Gemini API（サーバー側だけで使う。ブラウザには出さない） ---
GEMINI_API_KEY=
# 使うモデル名（例：Google AI Studio で試したモデル）
GEMINI_MODEL=

# --- Firebase（Web アプリの設定。ブラウザで使う公開用の値） ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Google Maps Platform（Places API。サーバー側で使う） ---
GOOGLE_MAPS_API_KEY=
