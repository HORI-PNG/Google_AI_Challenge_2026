# このファイルをコピーして .env.local を作り、値を入れてください。
# .env.local は Git に入れません。

# --- Gemini API（サーバー側だけで使う。ブラウザには出さない） ---
GEMINI_API_KEY=
# 使うモデル名（例：Google AI Studio で試したモデル）
GEMINI_MODEL=
# GEMINI_MODEL で3回続けて失敗したときに切り替える Gemini のモデル（例：Flash-Lite 系）。空なら切り替えない
GEMINI_FALLBACK_MODEL=
# 1 人 1 日に Gemini を使える回数（日記の分析・声・話しかけ・予報の合計）。空なら 50
GEMINI_DAILY_LIMIT=

# --- Firebase（Web アプリの設定。ブラウザで使う公開用の値） ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Google Maps Platform（Places API (New)。任意。費用がかかりうるため初期は使わない） ---
# 使わないとき（初期）：おすすめ場所は「Google マップで探す」リンクだけ（位置情報も使わない、無料）
# 使うとき：請求先を登録し、「API の制限」で Places API (New) だけに絞ったキーを入れ、下を true にする
# GOOGLE_MAPS_API_KEY はサーバー側だけで使う。ブラウザには出さない
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_PLACES_API_ENABLED=false
